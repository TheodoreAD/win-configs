{
  "cleanupPeriodDays": 365,
  "permissions": {
    "allow": [
      "WebSearch",
      "PowerShell(uv run invoke *)"
    ],
    "ask": [
      "WebFetch"
    ],
    "deny": [
      "Bash",
      "Artifact",
      "mcp__claude_ai_Claude_Docs"
    ]
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    }
  },
  "effortLevel": "high",
  "tui": "fullscreen",
  "defaultShell": "powershell",
  "statusLine": {
    "type": "command",
    "command": "pwsh -NoProfile -NoLogo -File \"__HOME__/.claude/status-line-max.ps1\""
  },
  "env": {
    "CLAUDE_CODE_USE_POWERSHELL_TOOL": "1"
  }
}
